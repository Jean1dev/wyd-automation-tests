{
  "name": "wyd-automation-tests",
  "version": "0.1.0",
  "private": true,
  "description": "Bots headless que automatizam casos de teste de gameplay do WYD (w2pp-OpenWYD) falando o protocolo CPSock direto com o tm-server.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "zone:extract": "tsx scripts/extract-newbie-zone.ts",
    "account:create": "tsx scripts/create-account.ts",
    "scenario:training-field": "tsx src/scenarios/trainingFieldLv35.ts"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  },
  "dependencies": {
    "dotenv": "^18.0.8"
  }
}
