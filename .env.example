# Servidor de teste (tm-server, TCP direto). Railway por padrão.
WYD_TARGET=reseau.proxy.rlwy.net:56950
WYD_CLIENT_VERSION=12000

# Conta comum de jogador (sem privilégios). Crie com: npm run account:create
WYD_ACCOUNT=
WYD_PASSWORD=
# PIN numérico de 6 dígitos. A primeira verificação numa conta nova define o PIN.
WYD_PIN=

# Segunda conta, só para o cenário de troca entre jogadores. Crie com: npm run account:create -- --second
WYD_ACCOUNT_B=
WYD_PASSWORD_B=
# Vazio = mesmo PIN da conta principal.
WYD_PIN_B=

# Conta do cenário do Arch (precisa de um slot livre). Crie com: npm run account:create -- --arch
WYD_ACCOUNT_ARCH=
WYD_PASSWORD_ARCH=
# Vazio = mesmo PIN da conta principal.
WYD_PIN_ARCH=

# Contas dos cenários de skills (um personagem por árvore). Crie com:
#   npm run account:create -- --foema | --bm | --ht | --tk
WYD_ACCOUNT_FOEMA=
WYD_PASSWORD_FOEMA=
WYD_ACCOUNT_BM=
WYD_PASSWORD_BM=
WYD_ACCOUNT_HT=
WYD_PASSWORD_HT=
WYD_ACCOUNT_TK=
WYD_PASSWORD_TK=
# Vazios = mesmo PIN da conta principal.
WYD_PIN_FOEMA=
WYD_PIN_BM=
WYD_PIN_HT=
WYD_PIN_TK=

# Prefixo dos personagens criados pelos bots (o nome final tem 4–12 alfanuméricos).
WYD_CHAR_PREFIX=bot
# Classe do personagem: 0=TransKnight 1=Foema 2=BeastMaster 3=Huntress
WYD_CHAR_CLASS=0

# Banco do servidor de teste (Postgres do db-server), para semear as pré-condições dos casos
# das quests (npm run quest). Pegue com: railway variables --service db-server (W2PP_DB_DSN).
WYD_DATABASE_URL=
# Espera máxima por uma conexão com o banco saturado ("too many connections"), em ms. Padrão 5 min.
WYD_DB_WAIT_MS=300000
