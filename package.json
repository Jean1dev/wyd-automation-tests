{
  "name": "wyd-automation-tests",
  "version": "0.1.0",
  "private": true,
  "description": "Bots headless que automatizam casos de teste de gameplay do WYD (w2pp-OpenWYD) falando o protocolo CPSock direto com o tm-server.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "zone:extract": "tsx scripts/extract-newbie-zone.ts",
    "account:create": "tsx scripts/create-account.ts",
    "scenario:training-field": "tsx src/scenarios/trainingFieldLv35.ts",
    "scenario:coveiro": "tsx src/scenarios/coveiroQuest.ts",
    "scenario:trade": "tsx src/scenarios/playerTrade.ts",
    "scenario:quest256": "tsx src/scenarios/quest256Chain.ts",
    "scenario:arch": "tsx src/scenarios/archCreation.ts",
    "scenario:foema-black": "tsx src/scenarios/skillTree.ts --tree negra",
    "scenario:foema-white": "tsx src/scenarios/skillTree.ts --tree branca",
    "scenario:foema-special": "tsx src/scenarios/skillTree.ts --tree especial",
    "scenario:bm-magia": "tsx src/scenarios/skillTree.ts --tree bm-magia",
    "scenario:bm-evocacao": "tsx src/scenarios/skillTree.ts --tree bm-evocacao",
    "scenario:bm-transformacao": "tsx src/scenarios/skillTree.ts --tree bm-transformacao",
    "scenario:ht-1": "tsx src/scenarios/skillTree.ts --tree ht-1",
    "scenario:ht-2": "tsx src/scenarios/skillTree.ts --tree ht-2",
    "scenario:ht-3": "tsx src/scenarios/skillTree.ts --tree ht-3",
    "scenario:tk-1": "tsx src/scenarios/skillTree.ts --tree tk-1",
    "scenario:tk-2": "tsx src/scenarios/skillTree.ts --tree tk-2",
    "scenario:tk-3": "tsx src/scenarios/skillTree.ts --tree tk-3",
    "quest": "tsx src/scenarios/quests/runner.ts",
    "quest:status": "tsx scripts/quest-status.ts"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  },
  "dependencies": {
    "dotenv": "^18.0.8"
  }
}
